APP_NAME=Electricity Bill Calculator
APP_VERSION=1.0.0
APP_ENV=development
# Supabase Production Database: postgresql+psycopg://powermanage.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://powermanage:PMdev_9Rk7m2Vx4Q@127.0.0.1:5433/powermanage
TEST_DATABASE_URL=postgresql+psycopg://powermanage:PMdev_9Rk7m2Vx4Q@127.0.0.1:5433/powermanage_test
BOOTSTRAP_TOKEN=replace-with-a-long-random-setup-token
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
# Production (cross-site HTTPS): SESSION_COOKIE_SECURE=true, SESSION_COOKIE_SAMESITE=none
# Omit SameSite to default to none in production/staging and lax in development.
RATE_LIMIT_ENABLED=false
# Production on Render: use Resend's HTTPS API (port 443). Verify the sending
# domain with Resend, then set these values in Render (never in the frontend).
EMAIL_TRANSPORT=resend
EMAIL_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=PowerManage
# The SMTP settings below are used only when EMAIL_TRANSPORT=smtp.

# Optional local-development SMTP fallback. Production does not use these.
# Gmail requires a Gmail App Password, not your Google account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM=your-account@gmail.com
MAIL_FROM_NAME=PowerManage
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
